// FDCAN filter setup for {{ fdcan_ctx.periph }}
static inline bool {{ fdcan_ctx.periph }}_set_filters(void) {
    {% if fdcan_ctx.accept_all %}
    // PHAL_CAN_init() installs the default accept-all policy.
    return true;
    {% elif fdcan_ctx.has_filters %}
    {% if fdcan_ctx.std_ids %}
    static const uint32_t sid_list[] = {
        {% for msg in fdcan_ctx.std_ids %}
        {{ msg.macro_name }}_MSG_ID{{ "," if not loop.last }}
        {% endfor %}
    };
    {% endif %}

    {% if fdcan_ctx.ext_ids %}
    static const uint32_t xid_list[] = {
        {% for msg in fdcan_ctx.ext_ids %}
        {{ msg.macro_name }}_MSG_ID{{ "," if not loop.last }}
        {% endfor %}
    };
    {% endif %}

    const PHAL_CAN_FilterConfig_t filters = {
        .standard_ids = {% if fdcan_ctx.std_ids %}sid_list{% else %}NULL{% endif %},
        .standard_id_count = {{ fdcan_ctx.std_ids|length }},
        .extended_ids = {% if fdcan_ctx.ext_ids %}xid_list{% else %}NULL{% endif %},
        .extended_id_count = {{ fdcan_ctx.ext_ids|length }},
    };
    return PHAL_CAN_setFilters(&PHAL_CAN{{ fdcan_ctx.periph[-1] }}, &filters);
    {% else %}
    // No filters configured; retain PHAL's default accept-all policy.
    return true;
    {% endif %}
}
